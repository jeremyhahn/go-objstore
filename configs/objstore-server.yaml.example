# go-objstore server configuration: pass with -config or OBJSTORE_CONFIG; precedence flags > env (OBJSTORE_<KEY_PATH>) > file > defaults; unknown keys are rejected; defaults listen on loopback only.

# backend: local
# path: ""
# path has no default: set it to the directory that holds the objects.

# grpc:
#   enabled: true
#   addr: "127.0.0.1:50051"
#   tls_cert: ""
#   tls_key: ""
#   max_recv_msg_size: 33554432
#   max_send_msg_size: 10485760

# rest:
#   enabled: true
#   host: 127.0.0.1
#   port: 8080
#   metrics_public: false
#   tls_cert: ""
#   tls_key: ""

# quic:
#   enabled: false
#   addr: "127.0.0.1:4433"
#   tls_cert: ""
#   tls_key: ""
#   self_signed: false
#   max_body_size: 104857600
#   read_timeout: 30s
#   write_timeout: 30s
#   idle_timeout: 1m0s
#   max_streams: 100

# mcp:
#   enabled: false
#   mode: http
#   addr: "127.0.0.1:8081"
#   tls_cert: ""
#   tls_key: ""

# unix:
#   enabled: false
#   socket: /var/run/objstore.sock

# rate_limit:
#   enabled: false
#   rps: 100
#   burst: 200
#   per_client: false

# audit:
#   enabled: true

# archive:
#   allow_client_local_destinations: false
# When false, clients cannot name a local filesystem archiver.

# replication:
#   allow_client_local_backends: false
# When false, policies with a local source or destination are refused.

# auth (off by default; see docs/configuration/auth.md): mutual TLS against client_ca, subjects or uid:N mapped to roles. Uncomment with "## " removed:
## auth:
##   client_ca: /etc/objstore/client-ca.pem
##   roles:
##     backup: [read, write, list]
##     prune: [delete]
##   identities:
##     - subject: backup-agent
##       roles: [backup]
##     - subject: "uid:1000"
##       roles: [backup, prune]
