# go-objstore server configuration (objstore-server and the single-transport
# objstore-*-server binaries). Copy to a gitignored path and name it with
# -config <file> or OBJSTORE_CONFIG=<file>.
#
# Precedence: flags > environment > this file > built-in defaults.
# Every key is also an environment variable: OBJSTORE_ + the key path in
# upper case joined with "_" (rest.host -> OBJSTORE_REST_HOST).
#
# Every key is commented out and shows its built-in default; uncomment only
# what you change. Each binary reads the sections for the transports it
# serves. Unknown keys are rejected at startup.
#
# The defaults are safe to start as is: gRPC, REST and MCP listen on
# loopback only, and QUIC and MCP are off. Set an address such as
# "0.0.0.0:50051" (or rest.host: 0.0.0.0) to listen beyond the machine.

# backend: local
# path: ""
# path has no default: the local backend refuses to start until it is set
# to the directory that holds the objects (for example /var/lib/objstore).

# grpc:
#   enabled: true
#   addr: "127.0.0.1:50051"
#   tls_cert: ""
#   tls_key: ""
#   max_recv_msg_size: 33554432
#   max_send_msg_size: 10485760

# rest:
#   enabled: true
#   host: 127.0.0.1
#   port: 8080
#   metrics_public: false
#   tls_cert: ""
#   tls_key: ""

# quic:
#   enabled: false
#   addr: "127.0.0.1:4433"
#   tls_cert: ""
#   tls_key: ""
#   self_signed: false
#   max_body_size: 104857600
#   read_timeout: 30s
#   write_timeout: 30s
#   idle_timeout: 1m0s
#   max_streams: 100

# mcp:
#   enabled: false
#   mode: http
#   addr: "127.0.0.1:8081"
#   tls_cert: ""
#   tls_key: ""

# unix:
#   enabled: false
#   socket: /var/run/objstore.sock

# rate_limit:
#   enabled: false
#   rps: 100
#   burst: 200
#   per_client: false

# audit:
#   enabled: true

# replication:
#   allow_client_local_backends: false
# Replication policies name their backends and settings, so a "local" backend
# could open any directory the service user can read. Policies with a local
# source or destination are refused (and a policy file holding one fails to
# load) unless this is true.

# auth is off by default: every listener then serves unauthenticated and logs
# a warning. Setting it requires a client certificate signed by client_ca on
# gRPC, REST, QUIC and MCP HTTP (each needs tls_cert and tls_key), maps the
# certificate common name, or uid:N on the Unix socket and MCP stdio, to
# roles, and refuses any action no role permits. An example, to uncomment
# with "## " removed (see docs/configuration/auth.md):
## auth:
##   client_ca: /etc/objstore/client-ca.pem
##   roles:
##     backup: [read, write, list]
##     prune: [delete]
##   identities:
##     - subject: backup-agent
##       roles: [backup]
##     - subject: "uid:1000"
##       roles: [backup, prune]
