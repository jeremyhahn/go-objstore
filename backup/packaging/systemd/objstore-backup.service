# objstore-backup as a long-running service; the schedule is in the configuration file. Install steps: backup/README.md.

[Unit]
Description=objstore-backup scheduled backup agent
Documentation=https://github.com/jeremyhahn/go-objstore/tree/main/docs/backup-agent
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=objstore-backup
Group=objstore-backup
ExecStart=/usr/local/bin/objstore-backup service --config /etc/objstore-backup/config.json
Restart=on-failure
RestartSec=30s
TimeoutStopSec=60s
Nice=10
IOSchedulingClass=idle

# Read every source without owning it: CAP_DAC_READ_SEARCH bypasses read and
# directory search permission checks, and grants nothing else.
AmbientCapabilities=CAP_DAC_READ_SEARCH
CapabilityBoundingSet=CAP_DAC_READ_SEARCH
# The passphrase and data key are held in locked memory.
LimitMEMLOCK=64M

NoNewPrivileges=yes
# The whole file system is read-only to the service, so it can read the
# sources and write nothing; it logs to the journal.
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
UMask=0077
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
SystemCallFilter=@system-service @memlock
SystemCallFilter=~@privileged
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
