# Hardened objstore-server service: read-only file system except ReadWritePaths= (keep in step with the config path); install steps in docs; listeners bind loopback by default.

[Unit]
Description=go-objstore object storage server
Documentation=https://github.com/jeremyhahn/go-objstore/tree/main/docs/configuration
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=objstore
Group=objstore
ExecStart=/usr/local/bin/objstore-server -config /etc/objstore/objstore-server.yaml
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s

# The storage root. Set it to the path key of the configuration file.
ReadWritePaths=/var/lib/objstore
# When the storage root is its own mount, put this line in [Unit] so the service starts after it:
# RequiresMountsFor=/var/lib/objstore

# /run/objstore, owned by the service user and removed when it stops. The
# Unix socket listener, when unix.enabled is set, is created there.
RuntimeDirectory=objstore
RuntimeDirectoryMode=0750
Environment=OBJSTORE_UNIX_SOCKET=/run/objstore/objstore.sock

# Cloud credentials: uncomment the matching pair; systemd copies each file into %d.
##LoadCredential=aws-credentials:/etc/objstore/credentials/aws-credentials
##Environment=AWS_SHARED_CREDENTIALS_FILE=%d/aws-credentials
##LoadCredential=gcp-service-account.json:/etc/objstore/credentials/gcp-service-account.json
##Environment=GOOGLE_APPLICATION_CREDENTIALS=%d/gcp-service-account.json

NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
# The whole file system is read-only to the service except ReadWritePaths=
# and RuntimeDirectory=; it logs to the journal.
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
UMask=0077
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
