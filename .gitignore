# Credentials and Secrets
*.env
*.env.*
.env
.env.*
*.key
*.pem
*.crt
.aws/
.azure/
credentials.json
secrets.yaml
secrets.yml

# Exception: Allow test certificates (except integration certs, which are
# regenerated by test/integration/server/generate-certs.sh at test time)
!**/test/**/*.crt
!**/test/**/*.key
!**/test/**/*.pem
!**/testdata/**/*.crt
!**/testdata/**/*.key
!**/testdata/**/*.pem
test/integration/server/certs/

# Exception: Allow JSON files in api directory
!api/**/*.json

# Configuration files
.objstore.yaml
.objstore-*.yaml
config.yaml
config.yml
local_config.yaml

# Build artifacts
bin/
dist/
*.so
*.dylib
*.dll
*.exe
*.test
# `*.test` is meant for compiled Go test binaries, but it also swallows
# test/integration/server/Dockerfile.test, which is real tracked source.
!**/Dockerfile.test
*.out
coverage/
coverage.txt
coverage.out
*.prof

# Example binaries (anchored to repo root so they never match package dirs
# such as pkg/storagefs/)
examples/*/basic-usage
examples/*/storagefs
examples/*/encryption
examples/*/lifecycle-policies
/basic-usage
/storagefs

# Server binaries built at repo root (use bin/ for release artifacts)
/objstore
/objstore-server
/objstore-rest-server
/objstore-grpc-server
/objstore-quic-server
/objstore-mcp-server

# Temporary documentation files
*_SUMMARY.md
*_FIXES_SUMMARY.md

# Test helper files
**/test_errors.go
**/test_errors_test.go

# OS files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
*~
.directory

