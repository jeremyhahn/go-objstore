# Allowlist for the devcontainer build context: exclude everything, then admit only what the stages COPY.
*
!go.mod
!go.sum
!backup/go.mod
!backup/go.sum
!api/sdks/go/go.mod
!api/sdks/go/go.sum
!examples/encryption/go.mod
!examples/encryption/go.sum
!scripts/tool-pins.sh
!scripts/install-tools.sh
!api/proto/**/*.go
!cmd/**/*.go
!cmd/**/*.h
!pkg/**/*.go
!internal/**/*.go
!test/integration/**/*.go
