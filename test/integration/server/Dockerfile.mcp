# syntax=docker/dockerfile:1.7
# Dockerfile for MCP server
FROM golang:1.27.4-alpine

# Allow Go toolchain auto-upgrade
ENV GOTOOLCHAIN=auto

# Install runtime dependencies
RUN apk add --no-cache ca-certificates curl

WORKDIR /app

# Copy go modules
COPY go.mod go.sum ./
# Resolve the private go-enclave module through an optional BuildKit secret holding only the token key, read on tmpfs and never kept in a layer.
RUN --mount=type=secret,id=gomodauth \
    set -eu; \
    if [ -s /run/secrets/gomodauth ]; then \
        export GOPRIVATE='github.com/jeremyhahn/*'; \
        export GIT_CONFIG_COUNT=1; \
        export GIT_CONFIG_KEY_0="$(cat /run/secrets/gomodauth)"; \
        export GIT_CONFIG_VALUE_0='https://github.com/jeremyhahn/'; \
    fi; \
    go mod download

# Copy source code
COPY . .

# Build MCP server with all backends
RUN go build -tags "local awss3 gcpstorage azureblob glacier azurearchive" -o /usr/local/bin/objstore-mcp-server ./cmd/objstore-mcp-server

# Create storage directory
RUN mkdir -p /tmp/objstore

EXPOSE 8081

# Run MCP server in HTTP mode
CMD ["objstore-mcp-server", "-mode", "http", "-addr", ":8081", "-backend", "local", "-path", "/tmp/objstore"]
