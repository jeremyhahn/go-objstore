# syntax=docker/dockerfile:1.7
# Server integration test runner image: toolchain and module cache; the repository is bind-mounted over /app.
FROM golang:1.27.4-alpine

# Allow Go toolchain auto-upgrade
ENV GOTOOLCHAIN=auto

# Build dependencies. ca-certificates is needed for the TLS/QUIC clients.
RUN apk add --no-cache \
    git \
    bash \
    ca-certificates

WORKDIR /app

# Copy go module files first so the module cache is baked into the image and
# the bind-mounted run does not re-download on every invocation.
COPY go.mod go.sum ./
# Resolve the private go-enclave module through an optional BuildKit secret holding only the token key, read on tmpfs and never kept in a layer.
RUN --mount=type=secret,id=gomodauth \
    set -eu; \
    if [ -s /run/secrets/gomodauth ]; then \
        export GOPRIVATE='github.com/jeremyhahn/*'; \
        export GIT_CONFIG_COUNT=1; \
        export GIT_CONFIG_KEY_0="$(cat /run/secrets/gomodauth)"; \
        export GIT_CONFIG_VALUE_0='https://github.com/jeremyhahn/'; \
    fi; \
    go mod download

# Run the server integration tests by default. docker-compose overrides this
# with a command that also builds the CLI from the bind-mounted source; keep
# the two tag lists in sync.
CMD ["go", "test", "-v", "-tags", "integration,local,awss3,gcpstorage,azureblob,glacier,azurearchive", "./test/integration/server/...", "-timeout", "15m"]
